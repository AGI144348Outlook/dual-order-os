    "lhea_letter": "he",
    "jurisdiction": "J1 Continuity — atmospheric state stream",
    "example": "/points/{lat},{lon} then /gridpoints/{office}/{x},{y}/forecast",
    "description": "US NWS API — no key required"
  },
